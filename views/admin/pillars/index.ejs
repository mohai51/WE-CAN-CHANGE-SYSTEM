<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>
<div style="padding: 32px;">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h1>Pillars</h1>
    <a class="btn btn-primary" style="width:auto;" href="/admin/pillars/new">+ Add Pillar</a>
  </div>

  <div class="card" style="margin-top:20px; padding:0; overflow:hidden;">
    <table style="width:100%; border-collapse: collapse;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border-color);">
          <th style="text-align:left; padding:14px 20px; color: var(--text-muted); font-size:13px;">Name</th>
          <th style="text-align:left; padding:14px 20px; color: var(--text-muted); font-size:13px;">Description</th>
          <th style="text-align:right; padding:14px 20px; color: var(--text-muted); font-size:13px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% pillars.forEach(p => { %>
        <tr style="border-bottom: 1px solid var(--border-color);">
          <td style="padding:14px 20px;"><%= p.name %></td>
          <td style="padding:14px 20px; color: var(--text-muted);"><%= p.description || '-' %></td>
          <td style="padding:14px 20px; text-align:right;">
            <a class="btn btn-secondary" style="width:auto; padding:6px 12px; display:inline-flex;" href="/admin/pillars/<%= p._id %>/edit">Edit</a>
            <form action="/admin/pillars/<%= p._id %>?_method=DELETE" method="POST" style="display:inline;">
              <button class="btn btn-secondary" style="width:auto; padding:6px 12px; color:#FCA5A5;" onclick="return confirm('Delete this pillar?')">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (pillars.length === 0) { %>
        <tr><td colspan="3" style="padding:20px; color: var(--text-muted); text-align:center;">No pillars yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../../partials/footer') %>
