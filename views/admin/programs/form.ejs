<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>
<div style="padding: 32px; max-width: 520px;">
  <h1><%= program ? 'Edit Program/Event' : 'Add Program/Event' %></h1>

  <div class="card" style="margin-top:20px;">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form method="POST" action="<%= program ? '/admin/programs/' + program._id + '?_method=PUT' : '/admin/programs' %>">
      <div class="form-group">
        <label for="title">Title</label>
        <input class="form-input" type="text" id="title" name="title" value="<%= program ? program.title : '' %>" required>
      </div>
      <div class="form-group">
        <label for="pillar">Pillar</label>
        <select class="form-input" id="pillar" name="pillar" required>
          <option value="">-- Select --</option>
          <% pillars.forEach(pl => { %>
            <option value="<%= pl._id %>" <%= program && String(program.pillar) === String(pl._id) ? 'selected' : '' %>><%= pl.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="type">Type</label>
        <select class="form-input" id="type" name="type">
          <option value="program" <%= program && program.type === 'program' ? 'selected' : '' %>>Program (ongoing)</option>
          <option value="event" <%= !program || program.type === 'event' ? 'selected' : '' %>>Event (one-off)</option>
        </select>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea class="form-input" id="description" name="description" rows="4"><%= program ? program.description : '' %></textarea>
      </div>
      <div class="form-group">
        <label for="date">Date</label>
        <input class="form-input" type="date" id="date" name="date" value="<%= program && program.date ? program.date.toISOString().slice(0,10) : '' %>">
      </div>
      <div class="form-group">
        <label for="location">Location</label>
        <input class="form-input" type="text" id="location" name="location" value="<%= program ? program.location : '' %>">
      </div>
      <button class="btn btn-primary" type="submit"><%= program ? 'Update' : 'Create' %></button>
    </form>
  </div>
</div>
<%- include('../../partials/footer') %>
