<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WCC Account Registration</title>
  <link rel="icon" type="image/png" href="/membership/assets/logo/WCC_logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0D131F;
      --card-bg: #162032;
      --card-border: rgba(255, 255, 255, 0.08);
      --text-main: #F8FAFC;
      --text-muted: #94A3B8;
      --wcc-gold: #F1AD1A;
      --wcc-crimson: #E63946;
      --accent-green: #2ECC71;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    body {
      background: radial-gradient(circle at 50% 20%, #1A2844 0%, var(--bg-dark) 80%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .auth-container {
      width: 100%;
      max-width: 500px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 2.25rem 2rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
      position: relative;
    }

    .auth-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: linear-gradient(90deg, var(--wcc-gold), var(--wcc-crimson));
    }

    .brand-header {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .brand-logo {
      width: 58px;
      height: 58px;
      margin: 0 auto 0.5rem;
      display: block;
      border-radius: 50%;
    }

    .brand-title {
      font-size: 1.3rem;
      font-weight: 800;
      color: #FFF;
    }

    .brand-subtitle {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    .alert {
      padding: 0.75rem 1rem;
      border-radius: 8px;
      margin-bottom: 1.25rem;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .alert-error {
      background: rgba(230, 57, 70, 0.15);
      border: 1px solid rgba(230, 57, 70, 0.35);
      color: #FF8A8A;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-row {
      display: flex;
      gap: 0.75rem;
    }

    .form-row .form-group {
      flex: 1;
    }

    .form-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 0.35rem;
      color: var(--text-main);
    }

    .form-control {
      width: 100%;
      padding: 0.7rem 0.85rem;
      background: rgba(13, 19, 31, 0.6);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      color: #FFF;
      font-size: 0.88rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-control:focus {
      border-color: var(--wcc-gold);
    }

    .btn {
      width: 100%;
      padding: 0.85rem;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 700;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1rem;
      background: linear-gradient(135deg, var(--wcc-gold) 0%, #D4920E 100%);
      color: #0F1218;
      transition: all 0.2s;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .auth-footer {
      text-align: center;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--card-border);
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .auth-footer a {
      color: var(--wcc-gold);
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="brand-header">
      <img src="/membership/assets/logo/WCC_logo.png" alt="WCC Logo" class="brand-logo" onerror="this.src='/finance/WCC_logo.png'">
      <h1 class="brand-title">Create WCC Account</h1>
      <p class="brand-subtitle">Join the We Can Change Digital Ecosystem</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">
        <span>⛔</span>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/auth/register">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Desired User ID *</label>
          <input type="text" name="userId" class="form-control" required placeholder="e.g. jahan01" autocomplete="username">
        </div>
        <div class="form-group">
          <label class="form-label">Full Name *</label>
          <input type="text" name="name" class="form-control" required placeholder="e.g. Jahanara Begum">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Email Address *</label>
        <input type="email" name="email" class="form-control" required placeholder="e.g. jahanara@example.com">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Password *</label>
          <input type="password" name="password" class="form-control" required placeholder="••••••••" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label class="form-label">Account Role *</label>
          <select name="role" id="roleSelect" class="form-control" onchange="toggleAdminKey()">
            <option value="member" <%= selectedRole === 'member' ? 'selected' : '' %>>Member</option>
            <option value="admin" <%= selectedRole === 'admin' ? 'selected' : '' %>>Administrator</option>
          </select>
        </div>
      </div>

      <div class="form-group" id="adminSecretGroup" style="display: <%= selectedRole === 'admin' ? 'block' : 'none' %>;">
        <label class="form-label">Admin Security Key (Required for Admin Role)</label>
        <input type="password" name="adminSecretKey" class="form-control" placeholder="Enter Admin Registration Secret">
        <small style="color:var(--text-muted); font-size:0.75rem;">Default setup key: <code>WCC_ADMIN_2026</code></small>
      </div>

      <div class="form-group">
        <label class="form-label">Phone Number (Optional)</label>
        <input type="tel" name="phone" class="form-control" placeholder="+880 1700 000000">
      </div>

      <button type="submit" class="btn">
        <span>Complete Registration &rarr;</span>
      </button>
    </form>

    <div class="auth-footer">
      Already have an account? <a href="/auth/login">Back to Sign In</a>
    </div>
  </div>

  <script>
    function toggleAdminKey() {
      const roleSelect = document.getElementById('roleSelect');
      const adminGroup = document.getElementById('adminSecretGroup');
      adminGroup.style.display = roleSelect.value === 'admin' ? 'block' : 'none';
    }
  </script>
</body>
</html>
